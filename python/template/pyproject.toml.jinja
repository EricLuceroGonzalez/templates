[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}" }]
requires-python = ">={{ python_version }}"
{%- if license == 'MIT' %}
license = "MIT"
{%- endif %}
dependencies = []

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff>=0.6",
{%- if project_type == 'research' %}
    "ipykernel>=6.29",
{%- endif %}
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"]

[tool.pytest.ini_options]
testpaths = ["tests"]
